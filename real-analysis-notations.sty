% Linked number-set notation.
\newcommand*{\NN}{\xref[\mathbb{N}]{\naturalNumbersRef}}
\newcommand*{\NNOne}{\xref[\mathbb{N}_{1}]{\positiveNaturalNumbersRef}}
\newcommand*{\ZZ}{\xref[\mathbb{Z}]{\integersRef}}
\newcommand*{\QQ}{\xref[\mathbb{Q}]{\rationalNumbersRef}}
\newcommand*{\II}{\xref[\mathbb{I}]{\irrationalNumbersRef}}
\newcommand*{\RR}{\xref[\mathbb{R}]{\realNumbersRef}}
\newcommand*{\card}[1]{\xref[\lvert#1\rvert]{\cardinalityRef}}
\newcommand*{\equinum}{\mathrel{\xref[\sim]{\sameCardinalityRef}}}
\newcommand*{\PowerSet}{\xref[\mathcal{P}]{\powerSetRef}}
\newcommand*{\img}[1]{{#1}^{\xref[\mathrm{img}]{\imageRef}}}
\newcommand*{\preimg}[1]{{#1}^{\xref[\mathrm{preimg}]{\preimageRef}}}
\newcommand*{\abs}[1]{\mathopen{\xref[\lvert]{\absoluteValueRef}}#1\mathclose{\xref[\rvert]{\absoluteValueRef}}}
\newcommand*{\dist}[2]{\xref[d(#1, #2)]{\distanceRef}}
\newcommand*{\OpenBall}{\mathop{\xref[\mathrm{OpenBall}]{\openBallRef}}\nolimits}
\newcommand*{\ball}[2]{\mathord{\xref[B]{\openBallNotationRef}}_{#1}(#2)}
\newcommand*{\floorfn}{\mathop{\xref[\mathrm{floor}]{\floorRef}}\nolimits}
\newcommand*{\floor}[1]{\xref[\lfloor #1 \rfloor]{\floorNotationRef}}
\newcommand*{\ceil}[1]{\xref[\lceil #1 \rceil]{\ceilRef}}
\newcommand*{\seqlim}{\mathop{\xref[\mathrm{lim}]{\seqLimitRef}}}
% The optional index domain keeps both zero-based and positive-indexed
% nested families explicit; parentheses and the carrier stay outside links.
\newcommand*{\Nested}[1][\NN]{%
  \mathop{\xref[\mathrm{Nested}]{\nestedSequencesRef}}\nolimits_{#1}%
}
\newcommand*{\Conv}{\mathop{\xref[\mathrm{Conv}]{\convergentSequencesRef}}\nolimits}
\newcommand*{\Bdd}{\mathop{\xref[\mathrm{Bdd}]{\boundedSequencesRef}}\nolimits}
\newcommand*{\term}[2]{{#1}_{\xref[#2]{\termNotationRef}}}
\newcommand*{\finsum}{\mathop{\xref[\mathrm{sum}]{\finiteSumRef}}\nolimits}
\newcommand*{\finprod}{\mathop{\xref[\mathrm{prod}]{\finiteProductRef}}\nolimits}
\newcommand*{\idxinter}{\mathop{\xref[\mathrm{inter}]{\indexedIntersectionRef}}\nolimits}
\newcommand*{\idxunion}{\mathop{\xref[\mathrm{union}]{\indexedUnionRef}}\nolimits}

% Sign-restricted subsets. In this course + and - are strict aliases.
% Link only the restriction so a carrier such as \RR can retain its own link.
\newcommand*{\apos}[1]{{#1}_{\xref[+]{\signSubsetsRef}}}
\newcommand*{\aneg}[1]{{#1}_{\xref[-]{\signSubsetsRef}}}
% Compatibility names render the same chosen strict-sign notation.
\newcommand*{\agtz}[1]{\apos{#1}}
\newcommand*{\altz}[1]{\aneg{#1}}
\newcommand*{\agez}[1]{{#1}_{\xref[\geq0]{\signSubsetsRef}}}
\newcommand*{\alez}[1]{{#1}_{\xref[\leq0]{\signSubsetsRef}}}

% Preserve the standard unlinked operators for exceptional contexts.
\let\raPlainSup\sup
\let\raPlainInf\inf
\let\raPlainMax\max
\let\raPlainMin\min
\let\raPlainSum\sum
\let\raPlainProd\prod
\let\raPlainBigcap\bigcap
\let\raPlainBigcup\bigcup

% Link only the operator head. Sets, subscripts, and other arguments remain
% outside the hyperlink and may contain linked notation of their own.
\renewcommand*{\sup}{%
  \mathop{\xref[\mathrm{sup}]{\supremumRef}}\nolimits
}
\renewcommand*{\inf}{%
  \mathop{\xref[\mathrm{inf}]{\infimumRef}}\nolimits
}
\renewcommand*{\max}{%
  \mathop{\xref[\mathrm{max}]{\binaryMaxRef}}\nolimits
}
\renewcommand*{\min}{%
  \mathop{\xref[\mathrm{min}]{\binaryMinRef}}\nolimits
}
\renewcommand*{\sum}{%
  \mathop{\xref[\raPlainSum]{\finiteSumNotationRef}}\limits
}
\renewcommand*{\prod}{%
  \mathop{\xref[\raPlainProd]{\finiteProductNotationRef}}\limits
}
\renewcommand*{\bigcap}{%
  \mathop{\xref[\raPlainBigcap]{\indexedIntersectionNotationRef}}\limits
}
\renewcommand*{\bigcup}{%
  \mathop{\xref[\raPlainBigcup]{\indexedUnionNotationRef}}\limits
}

% Infinite sum/product: operator with no decoration, taking the full sequence
% as its argument. Convention: if the operator has a top limit, it's finite
% (\sum_m^n(a)); if it has no top, it's infinite (\infsum(a)). The
% sequence's domain fixes the starting index implicitly.
\newcommand*{\infsum}{%
  \mathop{\xref[\raPlainSum]{\infiniteSumRef}}\limits
}
\newcommand*{\infprod}{%
  \mathop{\xref[\raPlainProd]{\infiniteProductRef}}\limits
}
