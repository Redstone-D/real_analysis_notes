\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{real-analysis-notations}[2026/09/28 Linked Real Analysis notation]

% Keep the owning project in the default targets so a dependent course may
% vendor and load this package without redirecting the links to itself.
\providecommand*{\supremumRef}{real-analysis::lec01::def:supremum}
\providecommand*{\infimumRef}{real-analysis::lec01::def:infimum}
\providecommand*{\naturalNumbersRef}{real-analysis::lec01::def:natural-number}
\providecommand*{\positiveNaturalNumbersRef}{real-analysis::lec01::conv:positive-natural-numbers}
\providecommand*{\integersRef}{real-analysis::lec01::def:integer}
\providecommand*{\rationalNumbersRef}{real-analysis::lec01::def:rational-numbers}
\providecommand*{\irrationalNumbersRef}{real-analysis::lec01::conv:irrational-numbers}
\providecommand*{\realNumbersRef}{real-analysis::lec01::rem:number-sets-inclusions-real}
\providecommand*{\cardinalityRef}{real-analysis::lec02::def:cardinality}
\providecommand*{\sameCardinalityRef}{real-analysis::lec02::def:same-cardinality}
\providecommand*{\powerSetRef}{real-analysis::lec02::def:power-set}
\providecommand*{\imageRef}{real-analysis::lec02::def:image}
\providecommand*{\preimageRef}{real-analysis::lec02::def:pre-image}
\providecommand*{\absoluteValueRef}{real-analysis::lec01::def:absolute-value}
\providecommand*{\neighbourhoodRef}{real-analysis::lec02::def:neighbourhood}

% Linked number-set notation.
\newcommand*{\NN}{\xref[\mathbb{N}]{\naturalNumbersRef}}
\newcommand*{\NNOne}{\xref[\mathbb{N}_{1}]{\positiveNaturalNumbersRef}}
\newcommand*{\ZZ}{\xref[\mathbb{Z}]{\integersRef}}
\newcommand*{\QQ}{\xref[\mathbb{Q}]{\rationalNumbersRef}}
\newcommand*{\II}{\xref[\mathbb{I}]{\irrationalNumbersRef}}
\newcommand*{\RR}{\xref[\mathbb{R}]{\realNumbersRef}}
\newcommand*{\card}[1]{\xref[\lvert#1\rvert]{\cardinalityRef}}
\newcommand*{\equinum}{\mathrel{\xref[\sim]{\sameCardinalityRef}}}
\newcommand*{\PowerSet}{\xref[\mathcal{P}]{\powerSetRef}}
\newcommand*{\img}[1]{{#1}^{\xref[\mathrm{img}]{\imageRef}}}
\newcommand*{\preimg}[1]{{#1}^{\xref[\mathrm{preimg}]{\preimageRef}}}
\newcommand*{\abs}[1]{\xref[\lvert#1\rvert]{\absoluteValueRef}}
\newcommand*{\neighbourhood}[2]{\xref[V_{#1}(#2)]{\neighbourhoodRef}}

% Preserve the standard unlinked operators for exceptional contexts.
\let\raPlainSup\sup
\let\raPlainInf\inf

% Link only the operator head. Sets, subscripts, and other arguments remain
% outside the hyperlink and may contain linked notation of their own.
\renewcommand*{\sup}{%
  \mathop{\xref[\mathrm{sup}]{\supremumRef}}\nolimits
}
\renewcommand*{\inf}{%
  \mathop{\xref[\mathrm{inf}]{\infimumRef}}\nolimits
}
